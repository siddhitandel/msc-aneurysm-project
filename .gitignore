# Large data — not ours to redistribute, and too big
data/
6678442/
*.npz
*.vtp

# Trained models / checkpoints (1.5G — never commit)
models/
*.pt
*.pth
*.ckpt

# Big mesh exports
*.stl
*.obj

# Logs
logs/
*.log
*.err

# Python cruft
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
*.swp

# Keep small result summaries + figures (exceptions below)
results*/*
!results*/
!results*/*.json
!results*/*.png

# --- Model checkpoints: keep the final "best" ones, exclude the rest ---
# Exclude the huge Stage-1 reconstruction folder (1.4G of epoch checkpoints)
models/reconstruction/
# Exclude throwaway test runs
models/*_test/
models/*_test2/
# Un-ignore the final best checkpoints (each ~13MB, safe for git)
!models/
!models/*/
!models/**/best*.pt

# --- Model checkpoints: keep the final "best" ones, exclude the rest ---
models/reconstruction/
models/*_test/
models/*_test2/
!models/
!models/*/
!models/**/best*.pt
