#!/bin/bash
#SBATCH --job-name=loc_cvae
#SBATCH --output=/users/strt0792/MSc_Project/aneurysm_project/logs/loccvae_%j.log
#SBATCH --error=/users/strt0792/MSc_Project/aneurysm_project/logs/loccvae_%j.err
#SBATCH --time=06:00:00
#SBATCH --mem=32G
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --partition=gpu

module load miniforge/24.7.1
source activate aneuseg
BASE="/users/strt0792/MSc_Project/aneurysm_project"
echo "Job started: $(date)"; nvidia-smi --query-gpu=name --format=csv,noheader

python "$BASE/scripts/location_cvae.py" train \
    --processed_dir "$BASE/data/processed_sdf" \
    --clinical_csv  /users/strt0792/MSc_Project/6678442/data/clinical.csv \
    --out_dir       "$BASE/models/location_cvae" \
    --n_epochs 800 --batch_size 8 --lr 5e-5 --n_freqs 3 --clamp_dist 0.2

echo "Job finished: $(date)"