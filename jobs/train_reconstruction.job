#!/bin/bash
#SBATCH --job-name=aneu_reconstruct
#SBATCH --output=/users/strt0792/MSc_Project/aneurysm_project/logs/reconstruct_%j.log
#SBATCH --error=/users/strt0792/MSc_Project/aneurysm_project/logs/reconstruct_%j.err
#SBATCH --time=12:00:00
#SBATCH --mem=32G
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --partition=gpu

module load miniforge/24.7.1
source activate aneuseg

BASE="/users/strt0792/MSc_Project/aneurysm_project"

echo "Job started  : $(date)"
echo "Node         : $SLURMD_NODENAME"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

python "$BASE/scripts/train_reconstruction.py" \
    --processed_dir "$BASE/data/processed" \
    --out_dir       "$BASE/models/reconstruction" \
    --mode          all \
    --model_size    medium \
    --n_epochs      500 \
    --lr            1e-4 \
    --batch_size    4096

echo "Job finished : $(date)"